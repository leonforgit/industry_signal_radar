# Copy to industry_signal_radar.env on the remote host and fill in real values.
# The runtime also accepts WATCHLIST_BARK_* and POLYMARKET_BARK_* fallbacks
# for easier reuse of existing monitor deployment habits.
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=
# Or provide multiple keys separated by commas:
# BARK_DEVICE_KEYS=key1,key2
# Optional hard cap for each scheduled scan, in seconds.
# RADAR_RUN_TIMEOUT_SECONDS=900
OPENBB_ENABLED=1
OPENBB_BASE_URL=http://127.0.0.1:6900
# Optional Kimi editorial / research-harness credentials.
# Public defaults keep the endpoint/model fixed in config; override them in a
# private config file only if you intentionally operate a different endpoint.
# Kimi Code membership key:
# KIMI_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# Kimi Code uses the K2.6 backend through the Kimi Code endpoint; the request model
# id should remain kimi-for-coding per Kimi Code API docs.
# KIMI_BASE_URL=https://api.kimi.com/coding
# KIMI_MODEL=anthropic/kimi-for-coding
# Kimi API Platform pay-as-you-go key. Prefer this for non-coding-agent production
# report automation if Kimi Code membership benefits return 401/402.
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.6
# Optional validation-only preview override:
# RADAR_ALERT_BODY_MODE=full
