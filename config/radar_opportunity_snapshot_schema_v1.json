{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar_opportunity_snapshot_schema_v1.json",
  "title": "Radar Opportunity Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "radar_run_id",
    "as_of_date",
    "market_tz",
    "ranking_version",
    "preference_profile",
    "summary",
    "objects"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "radar_run_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "market_sample_date": {
      "type": "string",
      "format": "date"
    },
    "event_window_end_date": {
      "type": "string",
      "format": "date"
    },
    "expected_sample_date": {
      "type": "string",
      "format": "date"
    },
    "market_tz": {
      "type": "string",
      "minLength": 1
    },
    "ranking_version": {
      "type": "string",
      "const": "v1"
    },
    "preference_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "early_discovery_first",
        "mixed_object_board",
        "bucketed_report"
      ],
      "properties": {
        "early_discovery_first": {
          "type": "boolean"
        },
        "mixed_object_board": {
          "type": "boolean"
        },
        "bucketed_report": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "strong_alert_count",
        "strong_candidate_count",
        "research_candidate_count",
        "observe_count",
        "bark_trigger_count"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "strong_alert_count": {
          "type": "integer",
          "minimum": 0
        },
        "strong_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "research_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "observe_count": {
          "type": "integer",
          "minimum": 0
        },
        "bark_trigger_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "market_sentiment_context": {
      "$ref": "#/$defs/marketSentimentContext"
    },
    "quant_signal_status": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/radarObject"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "event_id",
        "event_type"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "marketSentimentContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "lag_days": {
          "type": "integer",
          "minimum": 0
        },
        "market_flow_sentiment": {
          "type": "number"
        },
        "market_flow_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "market_flow_label": {
          "type": "string"
        },
        "market_event_sentiment": {
          "type": "number"
        },
        "market_event_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "market_event_label": {
          "type": "string"
        },
        "market_composite_sentiment": {
          "type": "number"
        },
        "market_composite_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "market_composite_label": {
          "type": "string"
        }
      }
    },
    "companySentimentContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "lag_days": {
          "type": "integer",
          "minimum": 0
        },
        "instrument": {
          "type": "string"
        },
        "company_name": {
          "type": "string"
        },
        "company_market_sentiment": {
          "type": "number"
        },
        "company_market_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "company_market_label": {
          "type": "string"
        },
        "company_event_sentiment": {
          "type": "number"
        },
        "company_event_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "company_event_label": {
          "type": "string"
        },
        "company_composite_sentiment": {
          "type": "number"
        },
        "company_composite_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "company_composite_label": {
          "type": "string"
        },
        "daily_return": {
          "type": "number"
        },
        "amount_ratio_20": {
          "type": "number"
        },
        "positive_days_5d": {
          "type": "number"
        },
        "fact_event_count_1d": {
          "type": "number"
        }
      }
    },
    "radarObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radar_object_type",
        "radar_object_id",
        "radar_object_name",
        "radar_object_scope",
        "runtime_state",
        "radar_bucket",
        "radar_score",
        "rank_in_bucket",
        "rank_overall",
        "alert_level",
        "catalyst_type",
        "hard_or_soft",
        "catalyst_stage",
        "next_milestone",
        "milestone_due_window",
        "event_driven_lane",
        "evidence_quality",
        "triage_action",
        "confirmation_gap",
        "hedge_difficulty",
        "failure_mode",
        "worth_watching",
        "why_now_strength",
        "confidence",
        "followup_value",
        "why_now",
        "key_evidence",
        "supporting_events",
        "followup_path",
        "risk_flags",
        "is_new",
        "is_upgraded",
        "previous_bucket",
        "trigger_state",
        "dedup_key",
        "primary_symbols",
        "etf_proxies",
        "theme_overlays",
        "research_links"
      ],
      "properties": {
        "radar_object_type": {
          "type": "string",
          "enum": [
            "industry",
            "macro",
            "company",
            "special_situation",
            "watchlist_priority_change"
          ]
        },
        "radar_object_id": {
          "type": "string",
          "minLength": 1
        },
        "radar_object_name": {
          "type": "string",
          "minLength": 1
        },
        "radar_object_scope": {
          "type": "string",
          "minLength": 1
        },
        "runtime_state": {
          "type": "string",
          "enum": [
            "cold",
            "warming",
            "candidate",
            "strong_alert"
          ]
        },
        "radar_bucket": {
          "type": "string",
          "enum": [
            "observe",
            "research_candidate",
            "strong_candidate",
            "strong_alert"
          ]
        },
        "radar_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rank_in_bucket": {
          "type": "integer",
          "minimum": 1
        },
        "rank_overall": {
          "type": "integer",
          "minimum": 1
        },
        "alert_level": {
          "type": "string",
          "enum": [
            "none",
            "watch",
            "candidate",
            "strong_alert"
          ]
        },
        "catalyst_type": {
          "type": "string",
          "enum": [
            "earnings_guidance",
            "approval_registration",
            "order_project",
            "capital_markets",
            "merger_restructuring",
            "buyback_shareholder_support",
            "financing_dilution",
            "litigation_regulatory",
            "dividend_capital_return",
            "distress_delisting",
            "industry_proxy",
            "policy_regulation",
            "macro_geopolitical",
            "product_operation",
            "general_corporate"
          ]
        },
        "hard_or_soft": {
          "type": "string",
          "enum": [
            "hard",
            "soft"
          ]
        },
        "catalyst_stage": {
          "type": "string",
          "enum": [
            "announced",
            "execution_window",
            "confirmation_window",
            "signal_clustered",
            "monitoring",
            "active_risk"
          ]
        },
        "next_milestone": {
          "type": "string",
          "minLength": 1
        },
        "milestone_due_window": {
          "type": "string",
          "enum": [
            "days_1_3",
            "days_3_10",
            "weeks_2_6",
            "open_ended"
          ]
        },
        "event_driven_lane": {
          "type": "string",
          "enum": [
            "hard_catalyst_board",
            "soft_catalyst_watchlist",
            "risk_monitor",
            "background_monitor"
          ]
        },
        "evidence_quality": {
          "type": "string",
          "enum": [
            "structured_confirmed",
            "proxy_confirmed",
            "early_thematic",
            "narrative_only",
            "risk_signal"
          ]
        },
        "triage_action": {
          "type": "string",
          "enum": [
            "immediate_research",
            "thesis_watch",
            "risk_review",
            "background_only"
          ]
        },
        "confirmation_gap": {
          "type": "string",
          "minLength": 1
        },
        "hedge_difficulty": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "failure_mode": {
          "type": "string",
          "minLength": 1
        },
        "worth_watching": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "why_now_strength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "followup_value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "sentiment_context": {
          "$ref": "#/$defs/companySentimentContext"
        },
        "quant_signal_context": {
          "type": "object",
          "additionalProperties": true
        },
        "why_now": {
          "type": "string",
          "minLength": 1
        },
        "key_evidence": {
          "$ref": "#/$defs/stringArray"
        },
        "supporting_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supportingEvent"
          }
        },
        "followup_path": {
          "$ref": "#/$defs/stringArray"
        },
        "risk_flags": {
          "$ref": "#/$defs/stringArray"
        },
        "is_new": {
          "type": "boolean"
        },
        "is_upgraded": {
          "type": "boolean"
        },
        "previous_bucket": {
          "type": "string",
          "enum": [
            "observe",
            "research_candidate",
            "strong_candidate",
            "strong_alert"
          ]
        },
        "trigger_state": {
          "type": "string",
          "enum": [
            "report_only",
            "bark_candidate",
            "bark_sent",
            "suppressed"
          ]
        },
        "dedup_key": {
          "type": "string",
          "minLength": 1
        },
        "primary_symbols": {
          "$ref": "#/$defs/stringArray"
        },
        "etf_proxies": {
          "$ref": "#/$defs/stringArray"
        },
        "theme_overlays": {
          "$ref": "#/$defs/stringArray"
        },
        "research_links": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
